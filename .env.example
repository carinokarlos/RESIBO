# Local development only. Use strong, private values for any deployed environment.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///budget_tracker.db
COOKIE_SECURE=0
RATELIMIT_STORAGE_URI=memory://

# Development only: use an email sandbox such as Mailtrap Email Sandbox.
# Sandbox messages appear in its test inbox and are not delivered to real users.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_DEFAULT_SENDER=Resibo <no-reply@example.com>
MAIL_USE_TLS=1
MAIL_USE_SSL=0

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://budget_user:password@localhost:5432/budget_tracker

# XAMPP MariaDB example (change the username/password to match your local setup):
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/budget_tracker?charset=utf8mb4
